+#[test]
+fn custom_base_replaces_stock_turns_off_responses_lite() {
+    let config = ModelsManagerConfig {
+        base_instructions: Some("curated chat base".to_string()),
+        custom_base_replaces_stock: true,
+        ..Default::default()
+    };
+
+    let model = with_config_overrides(lite_model(), &config);
+
+    // Responses Lite can only *add* instructions, so a base that is meant to
+    // replace the stock prompt must not go out over it.
+    assert!(!model.use_responses_lite);
+    assert_eq!(
+        model
+            .model_messages
+            .as_ref()
+            .and_then(|messages| messages.instructions_template.as_deref()),
+        Some("curated chat base"),
+    );
+}
+
+#[test]
+fn custom_base_keeps_responses_lite_when_boss_flag_is_off() {
+    // Normal Codex behaviour: a custom base alone changes nothing about transport.
+    let config = ModelsManagerConfig {
+        base_instructions: Some("curated chat base".to_string()),
+        custom_base_replaces_stock: false,
+        ..Default::default()
+    };
+
+    let model = with_config_overrides(lite_model(), &config);
+
+    assert!(model.use_responses_lite);
+}
+
+#[test]
+fn boss_flag_alone_does_not_touch_a_stock_base() {
+    let config = ModelsManagerConfig {
+        base_instructions: None,
+        custom_base_replaces_stock: true,
+        ..Default::default()
+    };
+
+    let model = with_config_overrides(lite_model(), &config);
+
