+//! Request-only evidence aging. The stored conversation is never rewritten.
+use super::estimate_item_token_count;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::ResponseItem;
+use std::collections::HashSet;
+
+/// Keep natural-language context when seeding a Boss worker, including commentary.
+pub(crate) fn durable_worker_item(item: &ResponseItem) -> bool {
+    matches!(
+        item,
+        ResponseItem::Message { .. } | ResponseItem::FunctionCallOutput { call_id: None, .. }
+    )
+}
+
+/// Replaces technical tool output older than the newest `recent_evidence_tokens`
+/// of it with a placeholder that says how to get it back.
+pub(crate) fn project(input: &mut [ResponseItem], recent_evidence_tokens: i64) {
+    // Unknown tools stay verbatim. Classify tool identity, never output keywords.
+    let technical_calls: HashSet<String> = input
+        .iter()
+        .filter_map(|item| {
+            let (call_id, name, namespace) = match item {
+                ResponseItem::FunctionCall {
+                    call_id,
+                    name,
+                    namespace,
+                    ..
+                }
+                | ResponseItem::CustomToolCall {
+                    call_id,
+                    name,
+                    namespace,
+                    ..
+                } => (call_id, name.as_str(), namespace.as_deref()),
+                _ => return None,
+            };
+            (matches!(
+                name,
+                "exec_command"
+                    | "write_stdin"
+                    | "shell"
+                    | "shell_command"
+                    | "read_file"
+                    | "list_dir"
+                    | "grep_files"
+            ) || matches!(
+                (namespace, name),
+                (Some("functions"), "exec" | "wait")
+                    | (Some("web"), "run")
+                    | (Some("mcp__cua_repl"), "js")
+            ))
+            .then(|| call_id.clone())
+        })
+        .collect();
+
+    // Keep the entire newest response batch: parallel results must be seen once,
+    // even when that batch alone exceeds the rolling budget.
+    let fresh_start = input
+        .iter()
+        .rposition(|item| {
+            matches!(
+                item,
+                ResponseItem::FunctionCall { .. }
+                    | ResponseItem::CustomToolCall { .. }
+                    | ResponseItem::Reasoning { .. }
+            ) || matches!(item, ResponseItem::Message { role, .. } if role == "assistant")
+        })
+        .map_or(0, |index| index + 1);
+    let mut used = 0_i64;
+    for (index, item) in input.iter_mut().enumerate().rev() {
+        let tokens = estimate_item_token_count(item);
+        let (call_id, output) = match item {
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                output,
+                ..
+            }
+            | ResponseItem::CustomToolCallOutput {
+                call_id, output, ..
+            } if technical_calls.contains(call_id) => (call_id, output),
+            _ => continue,
+        };
+        used = used.saturating_add(tokens);
+        if index < fresh_start && used > recent_evidence_tokens {
+            output.body = FunctionCallOutputBody::Text(
+                crate::boss_text::text(
+                    "evidence.omitted_placeholder",
+                    "[Earlier technical output omitted from active context. Call ID: {call_id}. \
+                     Original output remains in this thread's session log; reopen by call ID \
+                     or rerun the tool call above if needed.]",
+                )
+                .replace("{call_id}", call_id),
+            );
+        }
+    }
+}
