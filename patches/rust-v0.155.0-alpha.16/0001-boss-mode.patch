+}
+
+/// The stock instructions a Boss worker keeps: everything about how the model
+/// uses its tools and environment, without the `dropped_sections` that define
+/// its relationship to a user. A section runs until the next heading of the
+/// same or a higher level.
+pub(crate) fn boss_worker_stock_instructions(
+    stock_instructions: &str,
+    dropped_sections: &[String],
+) -> String {
+    let mut kept = Vec::new();
+    let mut dropping_level = None;
+    let mut in_fence = false;
+    for line in stock_instructions.lines() {
+        if line.trim_start().starts_with("```") {
+            in_fence = !in_fence;
+        }
+        let level = (!in_fence)
+            .then(|| line.chars().take_while(|c| *c == '#').count())
+            .filter(|level| *level > 0 && line[*level..].starts_with(' '));
+        if let Some(level) = level {
+            if dropping_level.is_some_and(|dropping| level <= dropping) {
+                dropping_level = None;
+            }
+            if dropping_level.is_none()
+                && dropped_sections
+                    .iter()
+                    .any(|heading| heading.trim_end() == line.trim_end())
+            {
+                dropping_level = Some(level);
+            }
+        }
+        if dropping_level.is_none() {
+            kept.push(line);
+        }
+    }
+    kept.join("\n").trim_end().to_string()
+}
+
+pub(crate) fn append_boss_stock_instructions(
+    base_instructions: &mut String,
+    stock_instructions: &str,
+) {
+    if stock_instructions.is_empty() {
+        return;
+    }
+    let suffix = format!("\n\n{stock_instructions}");
+    if !base_instructions.ends_with(&suffix) {
+        base_instructions.push_str(&suffix);
+    }
+}
