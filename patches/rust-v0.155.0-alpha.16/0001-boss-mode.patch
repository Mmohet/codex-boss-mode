@@ -0,0 +1,181 @@
+//! Reasoning-effort tools: the parent's `set_agent_effort` and a colleague's
+//! own `set_reasoning_effort`.
+//!
+//! Both exist because effort stopped being a spawn-time decision. The parent
+//! sees how a colleague's work is going from outside; the colleague notices
+//! from inside when the step in front of it got harder or easier. Neither
+//! change costs the colleague its cache.
+
+use super::analytics::ToolCallAnalytics;
+use super::*;
+use crate::agent::control::AgentEffortError;
+use crate::agent::control::AgentEffortOutcome;
+use crate::tools::handlers::multi_agents_spec::create_set_agent_effort_tool;
+use crate::tools::handlers::multi_agents_spec::create_set_reasoning_effort_tool;
+use codex_protocol::protocol::TurnSettingsUpdateOutcome;
+use codex_tools::ToolSpec;
+
+pub(crate) struct SetAgentEffortHandler;
+
+impl ToolExecutor<ToolInvocation> for SetAgentEffortHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("set_agent_effort")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        create_set_agent_effort_tool()
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let mut analytics =
+                ToolCallAnalytics::new(&invocation, CollabAgentTool::SetAgentEffort);
+            let result = handle_set_agent_effort(invocation, &mut analytics).await;
+            analytics.finish(&result);
+            result.map(boxed_tool_output)
+        })
+    }
+}
+
+impl CoreToolRuntime for SetAgentEffortHandler {
+    fn matches_kind(&self, payload: &ToolPayload) -> bool {
+        matches!(payload, ToolPayload::Function { .. })
+    }
+}
+
+async fn handle_set_agent_effort(
+    invocation: ToolInvocation,
+    analytics: &mut ToolCallAnalytics,
+) -> Result<EffortResult, FunctionCallError> {
+    let ToolInvocation {
+        session,
+        turn,
+        payload,
+        call_id,
+        ..
+    } = invocation;
+    let arguments = function_arguments(payload)?;
+    let args: SetAgentEffortArgs = parse_arguments(&arguments)?;
+    let agent_id = resolve_agent_target(&session, &turn, &args.target).await?;
+    analytics.set_receiver(agent_id);
+    let AgentEffortOutcome {
+        agent_path,
+        previous_effort,
+        running_turn,
+    } = session
+        .services
+        .agent_control
+        .set_spawned_agent_effort(session.thread_id, agent_id, args.reasoning_effort)
+        .await
+        .map_err(|err| match err {
+            AgentEffortError::InvalidRequest(message) => FunctionCallError::RespondToModel(message),
+            AgentEffortError::Agent(err) => collab_agent_error(agent_id, err),
+        })?;
+    emit_sub_agent_activity(
+        &session,
+        &turn,
+        SubAgentActivityItem {
+            id: call_id,
+            agent_thread_id: agent_id,
+            agent_path,
+            kind: SubAgentActivityKind::Interacted,
+        },
+    )
+    .await;
+    Ok(EffortResult::new(previous_effort, running_turn))
+}
+
+pub(crate) struct SetReasoningEffortHandler;
+
+impl ToolExecutor<ToolInvocation> for SetReasoningEffortHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("set_reasoning_effort")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        create_set_reasoning_effort_tool()
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let arguments = function_arguments(invocation.payload.clone())?;
+            let args: SetReasoningEffortArgs = parse_arguments(&arguments)?;
+            let previous_effort = invocation.turn.current_reasoning_effort();
+            // Only the rest of this turn: the level the parent chose is where the
+            // next turn starts, so a raise for one hard spot does not stick.
+            let running_turn = invocation
+                .session
+                .retune_effort(args.reasoning_effort, /*future_turns*/ false)
+                .await;
+            Ok(boxed_tool_output(EffortResult::new(
+                previous_effort,
+                running_turn,
+            )))
+        })
+    }
+}
+
+impl CoreToolRuntime for SetReasoningEffortHandler {
+    fn matches_kind(&self, payload: &ToolPayload) -> bool {
+        matches!(payload, ToolPayload::Function { .. })
+    }
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SetAgentEffortArgs {
+    target: String,
+    reasoning_effort: ReasoningEffort,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SetReasoningEffortArgs {
+    reasoning_effort: ReasoningEffort,
+}
+
+#[derive(Debug, Serialize)]
+pub(crate) struct EffortResult {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    previous_effort: Option<ReasoningEffort>,
+    /// `applied`, `no_turn_running`, or the reason the running turn refused.
+    running_turn: String,
+}
+
+impl EffortResult {
+    fn new(previous_effort: Option<ReasoningEffort>, running_turn: TurnSettingsUpdateOutcome) -> Self {
+        let running_turn = match running_turn {
+            TurnSettingsUpdateOutcome::Applied => "applied".to_string(),
+            TurnSettingsUpdateOutcome::TargetUnavailable => "no_turn_running".to_string(),
+            TurnSettingsUpdateOutcome::Rejected { reason } => format!("rejected: {reason}"),
+        };
+        Self {
+            previous_effort,
+            running_turn,
+        }
+    }
+}
+
+impl ToolOutput for EffortResult {
+    fn log_output(&self) -> String {
+        tool_output_json_text(self, "set_effort")
+    }
+
+    fn success_for_logging(&self) -> bool {
+        !self.running_turn.starts_with("rejected")
+    }
+
+    fn to_response_item(&self, call_id: &str, payload: &ToolPayload) -> ResponseInputItem {
+        tool_output_response_item(call_id, payload, self, Some(true), "set_effort")
+    }
+
+    fn code_mode_result(&self, _payload: &ToolPayload) -> JsonValue {
+        tool_output_code_mode_result(self, "set_effort")
+    }
+}
