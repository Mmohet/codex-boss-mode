+#[tokio::test]
+async fn boss_main_observation_gate_requires_one_visible_rationale_continuation() {
+    let (_session, turn_context) = make_session_and_context().await;
+    let first_request = BossMainObservationRequest::new(0);
+    assert!(first_request.admit(&turn_context).is_ok());
+    assert!(first_request.admit(&turn_context).is_ok());
+    assert_eq!(
+        turn_context
+            .turn_metadata_state
+            .boss_main_observation_calls(),
+        1
+    );
+
+    let second_request = BossMainObservationRequest::new(1);
+    let blocked = second_request
+        .admit(&turn_context)
+        .expect_err("rationale is required");
+    assert!(blocked.contains("visible rationale"));
+    let blocked_again = second_request
+        .admit(&turn_context)
+        .expect_err("the same observation stays blocked without rationale");
+    assert!(blocked_again.contains("visible rationale"));
+    assert_eq!(
+        turn_context
+            .turn_metadata_state
+            .boss_main_observation_calls(),
+        1
+    );
+
+    turn_context
+        .turn_metadata_state
+        .note_boss_main_visible_rationale();
+    assert!(second_request.admit(&turn_context).is_ok());
+    assert_eq!(
+        turn_context
+            .turn_metadata_state
+            .boss_main_observation_calls(),
+        2
+    );
+    let exhausted_same_request = second_request
+        .admit(&turn_context)
+        .expect_err("the continuation is one call only");
+    assert!(exhausted_same_request.contains("exhausted"));
+
+    let third_request = BossMainObservationRequest::new(2);
+    let exhausted = third_request
