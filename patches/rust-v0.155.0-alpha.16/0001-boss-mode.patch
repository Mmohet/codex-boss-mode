+async fn a_turn_event_sent_without_parent_notice_does_not_reach_the_parent() {
+    let harness = AgentControlHarness::new().await;
+    let mut config = harness.config.clone();
+    let _ = config.features.enable(Feature::MultiAgentV2);
+    let root = harness
+        .manager
+        .start_thread(StartThreadOptions::new(config.clone()))
+        .await
+        .expect("root thread should start");
+    let (_worker_id, worker) = spawn_v2_worker(&harness, &config, root.thread_id, "worker").await;
+    let reports_to_root = || {
+        harness
+            .manager
+            .captured_ops()
+            .into_iter()
+            .filter(|(thread_id, op)| {
+                *thread_id == root.thread_id && matches!(op, Op::InterAgentCommunication { .. })
+            })
+            .count()
+    };
+
+    // The first ordinary turn end also releases the spawn-time completion
+    // watcher, so later reports can only come from the turn-event path.
+    let turn = worker.session.new_default_turn().await;
+    worker
+        .session
+        .send_event(turn.as_ref(), turn_complete(turn.as_ref(), Some("done")))
+        .await;
+    timeout(Duration::from_secs(5), async {
+        while reports_to_root() == 0 {
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("an ordinary turn end should report to the parent");
+    sleep(Duration::from_millis(100)).await;
+    let reported = reports_to_root();
+
+    let turn = worker.session.new_default_turn().await;
+    worker
+        .session
+        .send_turn_event(
+            turn.as_ref(),
+            turn_complete(turn.as_ref(), None),
+            /*notify_parent*/ false,
+        )
+        .await;
+    sleep(Duration::from_millis(100)).await;
+    assert_eq!(reports_to_root(), reported);
+
+    let turn = worker.session.new_default_turn().await;
+    worker
+        .session
+        .send_event(turn.as_ref(), turn_complete(turn.as_ref(), Some("again")))
+        .await;
+    timeout(Duration::from_secs(5), async {
+        while reports_to_root() == reported {
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("a later ordinary turn end should still report to the parent");
+}
