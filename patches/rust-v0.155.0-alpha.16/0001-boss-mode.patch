+
+/// The sentence both Codex hosts open their side-conversation instructions with.
+const SIDE_CONVERSATION_MARKER: &str = "You are in a side conversation, not the main thread.";
+
+/// Returns whether this turn is a quick side question forked off a Boss Main.
+///
+/// A side conversation is not the decision layer: it answers a question and is
+/// thrown away, so the isolation that keeps Main's context clean has nothing to
+/// protect. It gets its own narrower rule instead: read-only, no colleagues.
+///
+/// Hosts mark a side conversation only through the developer instructions they
+/// send with an ephemeral fork. Core never shows the model those instructions
+/// on a fork (the inherited initial context is kept for the cache), which is
+/// why Boss states the boundary itself.
+pub(crate) fn boss_side_conversation_active(turn_context: &TurnContext) -> bool {
+    turn_context
+        .config
+        .features
+        .enabled(Feature::BossMainDecisionLayer)
+        && !turn_context.session_source.is_non_root_agent()
+        && turn_context.config.ephemeral
+        && turn_context
+            .developer_instructions
+            .as_deref()
+            .is_some_and(|instructions| instructions.contains(SIDE_CONVERSATION_MARKER))
+}
