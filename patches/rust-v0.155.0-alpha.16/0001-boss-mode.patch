+
+/// A side conversation keeps what Boss Main may use, plus the means to look
+/// without touching: the shell (narrowed to read-only at execution) and MCP
+/// tools that declare themselves read-only. Everything else a Worker would
+/// have — colleagues, patches, writing connectors, client tools with no
+/// provenance — is dropped here, before code mode builds its nested tool set,
+/// so neither direct calls nor `exec` can reach them.
+fn retain_side_conversation_tools(turn_context: &TurnContext, registry: &mut ToolRegistry) {
+    if !boss_side_conversation_active(turn_context) {
+        return;
+    }
+    let dropped = registry
+        .entries()
+        .filter(|tool| {
+            if tool.boss_main_capability != BossMainToolCapability::WorkerOnly {
+                return false;
+            }
+            if tool.runtime.mcp_server_name().is_some() {
+                return tool.runtime.mcp_read_only_hint() != Some(true);
+            }
+            let name = tool.runtime.tool_name();
+            !(name.is_default_namespace()
+                && matches!(
+                    name.name.as_str(),
+                    "exec_command"
+                        | "write_stdin"
+                        | "list_mcp_resources"
+                        | "list_mcp_resource_templates"
+                        | "read_mcp_resource"
+                ))
+        })
+        .map(|tool| tool.runtime.tool_name())
+        .collect::<Vec<_>>();
+    for tool_name in dropped {
+        registry.remove(&tool_name);
+    }
+}
