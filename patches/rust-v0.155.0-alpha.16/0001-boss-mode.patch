+#[derive(Clone)]
+pub(crate) struct BossMainObservationRequest {
+    calls_at_request_start: u8,
+    admitted_call: Arc<AtomicBool>,
+}
+
+impl BossMainObservationRequest {
+    pub(crate) fn new(calls_at_request_start: u8) -> Self {
+        Self {
+            calls_at_request_start,
+            admitted_call: Arc::new(AtomicBool::new(false)),
+        }
+    }
+
+    fn admit(&self, turn_context: &TurnContext) -> std::result::Result<(), &'static str> {
+        let state = &turn_context.turn_metadata_state;
+        match self.calls_at_request_start {
+            // The initial observation round may contain multiple parallel calls.
+            0 => {
+                if !self.admitted_call.swap(true, Ordering::AcqRel) {
+                    state.record_boss_main_observation_call();
+                }
+                Ok(())
+            }
+            // A second actual observation is a one-time continuation, gated by
+            // visible rationale in the conversation.
+            1 => {
+                if self.admitted_call.swap(true, Ordering::AcqRel) {
+                    return Err(BOSS_MAIN_OBSERVATION_EXHAUSTED_MESSAGE);
+                }
+                if state.take_boss_main_observation_rationale()
+                    && state.record_boss_main_observation_continuation()
+                {
+                    Ok(())
+                } else {
+                    self.admitted_call.store(false, Ordering::Release);
+                    Err(BOSS_MAIN_OBSERVATION_RATIONALE_MESSAGE)
+                }
+            }
+            _ => Err(BOSS_MAIN_OBSERVATION_EXHAUSTED_MESSAGE),
+        }
+    }
+}
+
+const BOSS_MAIN_OBSERVATION_RATIONALE_MESSAGE: &str = "Direct observation is unavailable for this turn. First write a visible rationale explaining why one more observation is necessary, or delegate the investigation to a worker.";
+const BOSS_MAIN_OBSERVATION_EXHAUSTED_MESSAGE: &str = "Direct observation is exhausted for this turn. Delegate any further investigation to a worker.";
+
+/// The tool to hold against Boss Main's observation budget, if any.
+///
+/// Only a call this runtime is about to execute can be held back. A hosted item,
+/// such as a server-side web search, already ran inside the response and its
+/// results are in front of the model; gating it could only count it against the
+/// budget and append a refusal, with no call id, beside results the model
+/// already has.
+fn boss_observation_to_gate(
+    item: &ResponseItem,
+    dispatch: &std::result::Result<Option<ToolCall>, FunctionCallError>,
+) -> Option<ToolName> {
+    if matches!(dispatch, Ok(Some(_))) {
+        response_item_tool_name(item)
+    } else {
+        None
+    }
+}
+
+fn response_item_tool_name(item: &ResponseItem) -> Option<ToolName> {
+    match item {
+        ResponseItem::FunctionCall {
+            name, namespace, ..
+        }
+        | ResponseItem::CustomToolCall {
+            name, namespace, ..
+        } => Some(ToolName::new(namespace.clone(), name.clone()).with_default_namespace()),
+        ResponseItem::ToolSearchCall { .. } => Some(ToolName::plain("tool_search")),
+        ResponseItem::LocalShellCall { .. } => Some(ToolName::plain("exec_command")),
+        ResponseItem::WebSearchCall { .. } => Some(ToolName::namespaced("web", "run")),
+        ResponseItem::ImageGenerationCall { .. } => {
+            Some(ToolName::namespaced("image_gen", "imagegen"))
+        }
+        _ => None,
+    }
 }
 
