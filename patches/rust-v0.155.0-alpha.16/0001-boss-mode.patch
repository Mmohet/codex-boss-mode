+        matches!(tool, ResponsesApiNamespaceTool::Function(tool) if tool.name == "followup_task")
+    }) else {
+        panic!("expected followup_task");
+    };
+    assert!(
+        followup
+            .parameters
+            .properties
+            .as_ref()
+            .is_some_and(|properties| properties.contains_key("reasoning_effort"))
+    );
+}
+
+fn read_only_mcp_runtime(server: &str, namespace: &str, name: &str) -> RegisteredTool {
+    let mut tool = mcp_tool(server, namespace, name);
+    tool.tool = tool
+        .tool
+        .annotate(rmcp::model::ToolAnnotations::new().read_only(true));
+    RegisteredTool {
+        runtime: Arc::new(McpHandler::new(tool).expect("MCP tool spec should build")),
+        exposure: ToolExposure::Direct,
+        boss_main_capability: BossMainToolCapability::WorkerOnly,
+    }
+}
+
+#[tokio::test]
+async fn boss_side_conversation_reads_without_colleagues_or_writes() {
+    let inputs = || ToolPlanInputs {
+        tool_runtimes: vec![
+            read_only_mcp_runtime("github", "mcp__github", "search_issues"),
+            mcp_runtime(
+                "github",
+                "mcp__github",
+                "create_issue",
+                ToolExposure::Direct,
+            ),
+        ],
+        dynamic_tools: vec![dynamic_tool(Some("clickup"), "list_tasks", false)],
+        ..ToolPlanInputs::default()
+    };
+    let configure = |side: bool| {
+        move |turn: &mut TurnContext| {
+            set_features(
+                turn,
+                &[
+                    Feature::BossMainDecisionLayer,
+                    Feature::MultiAgentV2,
+                    Feature::ShellTool,
+                    Feature::UnifiedExec,
+                    Feature::RequestPermissionsTool,
+                ],
+            );
+            update_turn_settings_for_test(turn, |settings| {
+                Arc::make_mut(&mut settings.model_info).shell_type =
+                    ConfigShellToolType::UnifiedExec;
+                Arc::make_mut(&mut settings.model_info).apply_patch_tool_type =
+                    Some(ApplyPatchToolType::Freeform);
+            });
+            update_config(turn, |config| config.ephemeral = side);
+            turn.developer_instructions = Some(
+                "Host instructions.\n\nYou are in a side conversation, not the main thread."
+                    .to_string(),
+            );
+        }
+    };
+    let search = ToolName::namespaced("mcp__github", "search_issues").to_string();
+    let create = ToolName::namespaced("mcp__github", "create_issue").to_string();
+    let dynamic = ToolName::namespaced("clickup", "list_tasks").to_string();
+
+    let side = probe_with(configure(true), inputs()).await;
+    side.assert_registered_contains(&["exec_command", "write_stdin", search.as_str()]);
+    side.assert_registered_lacks(&[
+        "apply_patch",
+        "request_permissions",
+        "spawn_agent",
+        "followup_task",
+        create.as_str(),
+        dynamic.as_str(),
+    ]);
+    side.assert_visible_lacks(&["spawn_agent", "apply_patch"]);
+
+    // Without the ephemeral fork it is Main itself: still no shell and no MCP.
+    let main = probe_with(configure(false), inputs()).await;
+    main.assert_registered_lacks(&["exec_command", search.as_str()]);
+}
+
+#[tokio::test]
+async fn boss_effort_and_compaction_tools_reach_the_models_that_use_them() {
+    let features = [
+        Feature::BossMainDecisionLayer,
+        Feature::MultiAgentV2,
+        Feature::StepModelSwitching,
+        Feature::ShellTool,
+        Feature::UnifiedExec,
+        Feature::CodeMode,
+    ];
+    let main = probe(|turn| set_features(turn, &features)).await;
+    let names = main
+        .namespace_function_names(MULTI_AGENT_V2_NAMESPACE)
+        .to_vec();
+    assert!(
+        names.contains(&"compact_agent".to_string())
+            && names.contains(&"set_agent_effort".to_string()),
+        "Main should see compact_agent and set_agent_effort, saw {names:?}"
+    );
+    // Every listed control must be exposed, or the router decides Main cannot
+    // manage colleagues at all.
+    assert!(main.can_manage_children);
+
+    // Workers run code-mode-only, where plain Direct tools fold into `exec`.
+    let worker = probe(|turn| {
+        set_features(turn, &features);
+        set_feature(turn, Feature::CodeModeOnly, /*enabled*/ true);
+        turn.session_source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id: ThreadId::new(),
+            depth: 1,
+            agent_path: Some(AgentPath::try_from("/root/worker").expect("valid agent path")),
+            agent_nickname: None,
+            agent_role: None,
+        });
+        update_turn_settings_for_test(turn, |settings| {
+            Arc::make_mut(&mut settings.model_info).shell_type = ConfigShellToolType::UnifiedExec;
+        });
+    })
+    .await;
+    assert_eq!(worker.tool_mode, ToolMode::CodeModeOnly);
+    worker.assert_visible_lacks(&["view_image"]);
+    worker.assert_visible_contains(&["set_reasoning_effort"]);
+}
diff --git a/codex-rs/core/src/tools/tool_call_tally.rs b/codex-rs/core/src/tools/tool_call_tally.rs
new file mode 100644
index 00000000..867248ab
--- /dev/null
+++ b/codex-rs/core/src/tools/tool_call_tally.rs
@@ -0,0 +1,71 @@
+//! Counts a thread's tool calls by name, so a parent can see the shape of what a
+//! colleague has been doing without reading its transcript.
+//!
+//! A context percentage says how heavy a colleague has become but not what made
+//! it heavy, and those need different answers: a colleague that read its way to
+//! 80% wants compacting, one grinding through forty small shell calls wants a
+//! narrower brief, and one writing files wants to be left alone. The histogram
+//! separates them; the percentage alone cannot.
+//!
+//! Counting happens at the single registry dispatch point every call passes
+//! through, including the calls made from inside code mode, so a worker that
+//! funnels reads and writes through `exec` is still counted per inner tool
+//! rather than collapsing into one bucket.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+/// Tool-call counts keyed by tool name.
+pub(crate) type ToolCallCounts = BTreeMap<String, u64>;
+
+#[derive(Clone, Default)]
+pub(crate) struct ToolCallTally {
+    counts: Arc<Mutex<ToolCallCounts>>,
+}
+
+impl ToolCallTally {
+    pub(crate) fn record(&self, tool_name: &str) {
+        let Ok(mut counts) = self.counts.lock() else {
+            return;
+        };
+        *counts.entry(tool_name.to_string()).or_insert(0) += 1;
+    }
+
+    pub(crate) fn snapshot(&self) -> ToolCallCounts {
+        self.counts
+            .lock()
+            .map(|counts| counts.clone())
+            .unwrap_or_default()
+    }
+}
+
+/// Remembers the tally each colleague had when the parent last looked.
+///
+/// The parent wants what changed since it last waited, not a running total: a
+/// total repeats everything already reported on every later wait, and grows
+/// without bound in a context that never forgets.
+#[derive(Clone, Default)]
+pub(crate) struct ToolCallTallyBaseline {
+    seen: Arc<Mutex<BTreeMap<String, ToolCallCounts>>>,
+}
+
+impl ToolCallTallyBaseline {
+    /// Returns what `current` added since the last call for `key`, then re-baselines.
+    pub(crate) fn take_delta(&self, key: &str, current: ToolCallCounts) -> ToolCallCounts {
+        let Ok(mut seen) = self.seen.lock() else {
+            return current;
+        };
+        let previous = seen.insert(key.to_string(), current.clone());
+        let Some(previous) = previous else {
+            return current;
+        };
+        current
+            .into_iter()
+            .filter_map(|(name, total)| {
+                let added = total.saturating_sub(previous.get(&name).copied().unwrap_or(0));
+                (added > 0).then_some((name, added))
+            })
+            .collect()
+    }
+}
