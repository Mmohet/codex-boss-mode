+/// Returns whether this turn is the root Boss Main decision layer.
+///
+/// Keep this check at the execution boundary as well as in tool planning:
+/// model output and owner-provided environments must not be able to turn a
+/// hidden tool back into a local implementation surface.
+pub(crate) fn boss_main_execution_isolation_active(turn_context: &TurnContext) -> bool {
+    turn_context
+        .config
