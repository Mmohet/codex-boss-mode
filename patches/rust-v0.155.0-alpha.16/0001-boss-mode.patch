+async fn spawn_v2_worker(
+    harness: &AgentControlHarness,
+    config: &Config,
+    parent_thread_id: ThreadId,
+    name: &str,
+) -> (ThreadId, Arc<CodexThread>) {
+    let thread_id = harness
+        .control
+        .spawn_agent(
+            config.clone(),
+            text_input("hello"),
+            Some(SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                parent_thread_id,
+                depth: 1,
+                agent_path: Some(AgentPath::root().join(name).expect("worker path")),
+                agent_nickname: None,
+                agent_role: None,
+            })),
+        )
+        .await
+        .expect("worker spawn should succeed");
+    let thread = harness
+        .manager
+        .get_thread(thread_id)
+        .await
+        .expect("worker thread should exist");
+    (thread_id, thread)
+}
