+//! Boss Mode: root turns the user chose plain Codex for by their model.
+
+use super::Session;
+use crate::session::turn_context::TurnContext;
+use codex_prompts::render_model_instructions;
+use codex_protocol::models::BaseInstructions;
+use codex_protocol::models::BaseInstructionsProvenance;
+
+impl Session {
+    /// The base instructions a request on this turn is sent with.
+    ///
+    /// A root turn on one of `[boss] direct_models` gets the stock instructions
+    /// for its model, as a normal Codex thread would, instead of the Boss base
+    /// the thread holds. Switching models already starts a new prompt cache, so
+    /// changing the instructions with the mode costs nothing more.
+    pub(crate) async fn prompt_base_instructions_for_turn(
+        &self,
+        turn_context: &TurnContext,
+    ) -> BaseInstructions {
+        if !crate::tools::boss_direct_turn(turn_context) {
+            return self.get_prompt_base_instructions().await;
+        }
+        let model = &turn_context.model_info().slug;
+        let mut stock_overrides = turn_context.config.to_models_manager_config();
+        stock_overrides.base_instructions = None;
+        stock_overrides.custom_base_replaces_stock = false;
+        let model_info = self
+            .services
+            .models_manager
+            .get_model_info(model, &stock_overrides)
+            .await;
+        let text = render_model_instructions(&model_info);
+        let text = if !turn_context.config.update_plan_enabled
+            && turn_context.config.model_catalog.is_none()
+        {
+            codex_prompts::without_update_plan_instructions(&text)
+        } else {
+            text
+        };
+        BaseInstructions {
+            text,
+            provenance: Some(BaseInstructionsProvenance::Model {
+                model: model.clone(),
+            }),
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "boss_direct_tests.rs"]
+mod tests;
