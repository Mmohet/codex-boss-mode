+++ b/codex-rs/core/src/agent/control/effort.rs
@@ -0,0 +1,84 @@
+//! Moves a spawned colleague's reasoning effort after it has started.
+//!
+//! Effort used to be fixed at spawn because changing it later made the provider
+//! re-read the whole context at full price. GPT-6 caches across effort levels,
+//! so a long-lived colleague can be run at the level each stretch of work needs
+//! instead of the level its first assignment needed.
+//!
+//! Root and self targets are rejected, matching interruption and compaction.
+//! An unloaded runtime is an error rather than a reload: a follow-up carries
+//! its own effort and loads the colleague on the way.
+
+use super::AgentControl;
+use codex_protocol::AgentPath;
+use codex_protocol::ThreadId;
+use codex_protocol::error::CodexErr;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_protocol::protocol::TurnSettingsUpdateOutcome;
+
+pub(crate) struct AgentEffortOutcome {
+    pub(crate) agent_path: AgentPath,
+    pub(crate) previous_effort: Option<ReasoningEffort>,
+    /// Whether a turn already under way took the new level for its remaining steps.
+    pub(crate) running_turn: TurnSettingsUpdateOutcome,
+}
+
+/// Keeps request validation distinct from runtime failures for the tool adapter's error mapping.
+#[derive(Debug)]
+pub(crate) enum AgentEffortError {
+    InvalidRequest(String),
+    Agent(CodexErr),
+}
+
+impl AgentControl {
+    /// Sets the level a colleague's later turns start at and, when it is
+    /// mid-turn, the level for the rest of that turn.
+    pub(crate) async fn set_spawned_agent_effort(
+        &self,
+        caller: ThreadId,
+        target: ThreadId,
+        effort: ReasoningEffort,
+    ) -> Result<AgentEffortOutcome, AgentEffortError> {
+        let receiver_agent = self
+            .ensure_agent_known(target)
+            .map_err(AgentEffortError::Agent)?;
+        if receiver_agent
+            .agent_path
+            .as_ref()
