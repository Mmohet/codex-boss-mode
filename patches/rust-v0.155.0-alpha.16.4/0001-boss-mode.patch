+fn remove_boss_main_mcp_tools(turn_context: &TurnContext, registry: &mut ToolRegistry) {
+    if !boss_main_execution_isolation_active(turn_context) {
+        return;
+    }
+
+    let mcp_tool_names = registry
+        .entries()
+        .filter(|tool| tool.runtime.mcp_server_name().is_some())
+        .map(|tool| tool.runtime.tool_name())
+        .collect::<Vec<_>>();
+    for tool_name in mcp_tool_names {
+        registry.remove(&tool_name);
+    }
