+#[tokio::test]
+async fn boss_main_wait_holds_past_its_timeout_while_a_colleague_works() {
+    let (mut session, mut turn) = make_session_and_context().await;
+    let manager = thread_manager();
+    let root = manager
+        .start_thread(StartThreadOptions::new((*turn.config).clone()))
+        .await
+        .expect("root thread should start");
+    session.services.agent_control = manager.agent_control();
+    session.thread_id = root.thread_id;
+    let mut config = (*turn.config).clone();
+    for feature in [Feature::MultiAgentV2, Feature::BossMainDecisionLayer] {
+        config
+            .features
+            .enable(feature)
+            .expect("test config should allow feature update");
+    }
+    config.multi_agent_v2.min_wait_timeout_ms = 1;
+    config.multi_agent_v2.max_wait_timeout_ms = 1_000;
+    config.multi_agent_v2.default_wait_timeout_ms = 20;
+    set_turn_config(&mut turn, config);
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+
+    SpawnAgentHandlerV2::default()
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "spawn_agent",
+            function_payload(json!({
+                "message": "boot worker",
+                "task_name": "worker"
+            })),
+        ))
+        .await
+        .expect("spawn worker");
+    let agent_id = session
+        .services
+        .agent_control
+        .resolve_agent_reference(session.thread_id, &turn.session_source, "worker")
+        .await
+        .expect("relative path should resolve");
+    let worker_path = session
+        .services
+        .agent_control
+        .get_agent_metadata(agent_id)
+        .expect("worker metadata")
+        .agent_path
+        .expect("worker path");
+    assert!(session.services.agent_control.any_colleague_working().await);
+
+    let wait_task = tokio::spawn({
+        let session = session.clone();
+        let turn = turn.clone();
+        async move {
+            WaitAgentHandlerV2::default()
+                .handle(invocation(
+                    session,
+                    turn,
+                    "wait_agent",
+                    function_payload(json!({})),
+                ))
+                .await
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(/*millis*/ 150)).await;
+    assert!(
+        !wait_task.is_finished(),
+        "a timeout with a colleague still working should not return to the model"
+    );
+
+    session
+        .input_queue
+        .enqueue_mailbox_communication(
+            InterAgentCommunication::new(
+                worker_path.clone(),
+                AgentPath::root(),
+                Vec::new(),
+                "still reading".to_string(),
+                /*trigger_turn*/ false,
+            ),
+            Default::default(),
+        )
+        .await;
+    tokio::time::sleep(Duration::from_millis(/*millis*/ 150)).await;
+    assert!(
+        !wait_task.is_finished(),
+        "a plain update should wait until Boss main next looks"
+    );
+
+    let mut question = InterAgentCommunication::new(
+        worker_path,
+        AgentPath::root(),
+        Vec::new(),
+        "found it; which way?".to_string(),
+        /*trigger_turn*/ false,
+    );
+    question.for_judgment = true;
+    session
+        .input_queue
+        .enqueue_mailbox_communication(question, Default::default())
+        .await;
+    let output = timeout(Duration::from_secs(/*secs*/ 1), wait_task)
+        .await
+        .expect("a message asking for judgment should end the wait")
+        .expect("wait task should join")
+        .expect("wait_agent should succeed");
+    let (content, _) = expect_text_output(output);
+    let result: crate::tools::handlers::multi_agents_v2::wait::WaitAgentResult =
+        serde_json::from_str(&content).expect("wait_agent result should be json");
+    assert_eq!(
+        (result.message.as_str(), result.timed_out),
+        ("Wait completed.", false)
+    );
+}
