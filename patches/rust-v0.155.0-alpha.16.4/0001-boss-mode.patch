diff --git a/codex-rs/core/src/tools/tool_call_tally.rs b/codex-rs/core/src/tools/tool_call_tally.rs
new file mode 100644
index 00000000..867248ab
--- /dev/null
+++ b/codex-rs/core/src/tools/tool_call_tally.rs
@@ -0,0 +1,71 @@
+//! Counts a thread's tool calls by name, so a parent can see the shape of what a
+//! colleague has been doing without reading its transcript.
+//!
+//! A context percentage says how heavy a colleague has become but not what made
+//! it heavy, and those need different answers: a colleague that read its way to
+//! 80% wants compacting, one grinding through forty small shell calls wants a
+//! narrower brief, and one writing files wants to be left alone. The histogram
+//! separates them; the percentage alone cannot.
+//!
+//! Counting happens at the single registry dispatch point every call passes
+//! through, including the calls made from inside code mode, so a worker that
+//! funnels reads and writes through `exec` is still counted per inner tool
+//! rather than collapsing into one bucket.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+/// Tool-call counts keyed by tool name.
+pub(crate) type ToolCallCounts = BTreeMap<String, u64>;
+
+#[derive(Clone, Default)]
+pub(crate) struct ToolCallTally {
+    counts: Arc<Mutex<ToolCallCounts>>,
+}
+
+impl ToolCallTally {
+    pub(crate) fn record(&self, tool_name: &str) {
+        let Ok(mut counts) = self.counts.lock() else {
+            return;
+        };
+        *counts.entry(tool_name.to_string()).or_insert(0) += 1;
+    }
+
+    pub(crate) fn snapshot(&self) -> ToolCallCounts {
+        self.counts
+            .lock()
+            .map(|counts| counts.clone())
+            .unwrap_or_default()
+    }
+}
+
+/// Remembers the tally each colleague had when the parent last looked.
+///
+/// The parent wants what changed since it last waited, not a running total: a
+/// total repeats everything already reported on every later wait, and grows
+/// without bound in a context that never forgets.
+#[derive(Clone, Default)]
+pub(crate) struct ToolCallTallyBaseline {
+    seen: Arc<Mutex<BTreeMap<String, ToolCallCounts>>>,
+}
+
+impl ToolCallTallyBaseline {
+    /// Returns what `current` added since the last call for `key`, then re-baselines.
+    pub(crate) fn take_delta(&self, key: &str, current: ToolCallCounts) -> ToolCallCounts {
+        let Ok(mut seen) = self.seen.lock() else {
+            return current;
+        };
+        let previous = seen.insert(key.to_string(), current.clone());
+        let Some(previous) = previous else {
+            return current;
+        };
+        current
+            .into_iter()
+            .filter_map(|(name, total)| {
+                let added = total.saturating_sub(previous.get(&name).copied().unwrap_or(0));
+                (added > 0).then_some((name, added))
+            })
+            .collect()
+    }
+}
