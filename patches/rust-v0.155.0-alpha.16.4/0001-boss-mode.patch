@@ -0,0 +1,94 @@
+//! Compacts a spawned colleague's context in place.
+//!
+//! A worker that has walked far carries every file it read and every command it
+//! ran into each later request, so the same work costs several times more late
+//! in a run than early. Replacing the worker is the obvious fix and the wrong
+//! one: a fresh colleague starts near zero but has to rebuild its picture of the
+//! project first, which is the expensive part. Compaction keeps the colleague
+//! and its understanding and drops the transcript weight instead.
+//!
+//! Root and self targets are rejected, matching interruption. An unloaded or
+//! already-dead runtime is a successful no-op; this never reloads one.
+
+use super::AgentControl;
+use crate::agent::AgentStatus;
+use codex_protocol::AgentPath;
+use codex_protocol::ThreadId;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::CodexErrorDetails;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::Op;
+
+pub(crate) struct AgentCompactOutcome {
+    pub(crate) agent_path: AgentPath,
+    pub(crate) previous_status: AgentStatus,
+}
+
+/// Keeps request validation distinct from runtime failures for the tool adapter's error mapping.
+#[derive(Debug)]
+pub(crate) enum AgentCompactError {
+    InvalidRequest(String),
+    Agent(CodexErr),
+}
+
+impl AgentControl {
+    /// Asks a spawned colleague to compact its own context, keeping the thread alive.
+    pub(crate) async fn compact_spawned_agent(
+        &self,
+        caller: ThreadId,
+        target: ThreadId,
+    ) -> Result<AgentCompactOutcome, AgentCompactError> {
+        let receiver_agent = self
+            .ensure_agent_known(target)
+            .map_err(AgentCompactError::Agent)?;
+        if receiver_agent
+            .agent_path
+            .as_ref()
+            .is_some_and(AgentPath::is_root)
+        {
+            return Err(AgentCompactError::InvalidRequest(
+                "root is not a spawned agent".to_string(),
+            ));
+        }
+        if target == caller {
+            return Err(AgentCompactError::InvalidRequest(
+                "an agent cannot compact itself through this tool".to_string(),
+            ));
+        }
+        let agent_path = receiver_agent.agent_path.clone().ok_or_else(|| {
+            AgentCompactError::InvalidRequest("target agent is missing an agent_path".to_string())
+        })?;
+        let previous_status = self.get_status(target).await;
+        match self.compact_agent(target).await {
+            Ok(_) => {}
+            Err(err)
+                if matches!(
+                    err.details(),
+                    CodexErrorDetails::ThreadNotFound(_) | CodexErrorDetails::InternalAgentDied
+                ) => {}
+            Err(err) => return Err(AgentCompactError::Agent(err)),
+        }
+        Ok(AgentCompactOutcome {
+            agent_path,
+            previous_status,
+        })
+    }
+
+    /// Sends `Op::Compact` to a child thread, the same path interruption uses.
+    pub(crate) async fn compact_agent(&self, agent_id: ThreadId) -> CodexResult<String> {
+        let state = self.upgrade()?;
+        self.handle_thread_request_result(
+            agent_id,
+            &state,
+            state
+                .send_op(
+                    agent_id,
+                    Op::Compact,
+                    /*parent_turn_id*/ None,
+                    /*root_turn_id*/ None,
+                )
+                .await,
+        )
+        .await
+    }
+}
