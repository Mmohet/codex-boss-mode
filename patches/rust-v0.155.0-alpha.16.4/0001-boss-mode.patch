+
+    // The first ordinary turn end also releases the spawn-time completion
+    // watcher, so later reports can only come from the turn-event path.
+    let turn = worker.session.new_default_turn().await;
+    worker
+        .session
+        .send_event(turn.as_ref(), turn_complete(turn.as_ref(), Some("done")))
+        .await;
+    timeout(Duration::from_secs(5), async {
+        while reports_to_root() == 0 {
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("an ordinary turn end should report to the parent");
+    sleep(Duration::from_millis(100)).await;
+    let reported = reports_to_root();
+
+    let turn = worker.session.new_default_turn().await;
+    worker
+        .session
