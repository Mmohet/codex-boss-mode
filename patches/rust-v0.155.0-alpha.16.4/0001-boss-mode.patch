@@ -0,0 +1,79 @@
+use super::*;
+use crate::session::tests::make_session_and_context_with_auth_and_config_and_rx;
+use codex_features::Feature;
+use codex_login::CodexAuth;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::permissions::FileSystemAccessMode;
+use codex_protocol::protocol::SessionSource;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+
+const BOSS_BASE: &str = "# Boss base";
+
+fn can_write(profile: &PermissionProfile) -> bool {
+    profile
+        .file_system_sandbox_policy()
+        .entries
+        .iter()
+        .any(|entry| entry.access == FileSystemAccessMode::Write)
+}
+
+/// A root Boss session whose model is, or is not, one of `[boss] direct_models`.
+async fn root_turn(direct: bool) -> (Arc<Session>, Arc<TurnContext>) {
+    let (session, turn, _events) = make_session_and_context_with_auth_and_config_and_rx(
+        CodexAuth::from_api_key("Test API Key"),
+        Vec::new(),
+        |config| {
+            config
+                .features
+                .enable(Feature::BossMainDecisionLayer)
+                .expect("Boss decision-layer feature should be enabled");
+            config
+                .permissions
+                .set_permission_profile(PermissionProfile::workspace_write())
+                .expect("workspace-write profile should be accepted");
+            super::super::apply_boss_main_decision_layer(config, &SessionSource::Cli)
+                .expect("root Boss permissions should be narrowed");
+            config.base_instructions = Some(BOSS_BASE.to_string());
+            config.base_instructions_provenance = Some(BaseInstructionsProvenance::Custom);
+            if direct {
+                config.boss_direct_models = vec![config.model.clone().expect("test model")];
+            }
+        },
+    )
+    .await;
+    (session, turn)
+}
+
+#[tokio::test]
+async fn a_root_turn_on_a_direct_model_runs_like_normal_codex() {
+    let (boss_session, boss_turn) = root_turn(/*direct*/ false).await;
+    let (direct_session, direct_turn) = root_turn(/*direct*/ true).await;
+
+    let boss_base = boss_session
+        .prompt_base_instructions_for_turn(&boss_turn)
+        .await;
+    let direct_base = direct_session
+        .prompt_base_instructions_for_turn(&direct_turn)
+        .await;
+    assert_eq!(
+        (
+            can_write(&boss_turn.permission_profile()),
+            can_write(&direct_turn.permission_profile()),
+            boss_base.text == BOSS_BASE,
+            direct_base.text == BOSS_BASE,
+            direct_base.provenance,
+        ),
+        (
+            false,
+            true,
+            true,
+            false,
+            Some(BaseInstructionsProvenance::Model {
+                model: direct_turn.model_info().slug.clone(),
+            }),
+        ),
+        "Boss main stays read-only on the Boss base; a direct turn gets the thread's \
+         permissions and the stock instructions for its model"
+    );
+}
