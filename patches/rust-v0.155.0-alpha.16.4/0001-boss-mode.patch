new file mode 100644
index 00000000..c7c76fea
--- /dev/null
+++ b/codex-rs/core/src/context_manager/boss_projection.rs
@@ -0,0 +1,100 @@
+//! Request-only evidence aging. The stored conversation is never rewritten.
+use super::estimate_item_token_count;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::ResponseItem;
+use std::collections::HashSet;
+
+/// Keep natural-language context when seeding a Boss worker, including commentary.
+pub(crate) fn durable_worker_item(item: &ResponseItem) -> bool {
+    matches!(
+        item,
+        ResponseItem::Message { .. } | ResponseItem::FunctionCallOutput { call_id: None, .. }
+    )
+}
+
+/// Replaces technical tool output older than the newest `recent_evidence_tokens`
+/// of it with a placeholder that says how to get it back.
+pub(crate) fn project(input: &mut [ResponseItem], recent_evidence_tokens: i64) {
+    // Unknown tools stay verbatim. Classify tool identity, never output keywords.
+    let technical_calls: HashSet<String> = input
+        .iter()
+        .filter_map(|item| {
+            let (call_id, name, namespace) = match item {
+                ResponseItem::FunctionCall {
+                    call_id,
+                    name,
+                    namespace,
+                    ..
+                }
+                | ResponseItem::CustomToolCall {
+                    call_id,
+                    name,
+                    namespace,
+                    ..
+                } => (call_id, name.as_str(), namespace.as_deref()),
+                _ => return None,
+            };
+            (matches!(
+                name,
+                "exec_command"
+                    | "write_stdin"
+                    | "shell"
+                    | "shell_command"
+                    | "read_file"
+                    | "list_dir"
+                    | "grep_files"
+            ) || matches!(
+                (namespace, name),
+                (Some("functions"), "exec" | "wait")
+                    | (Some("web"), "run")
+                    | (Some("mcp__cua_repl"), "js")
+            ))
+            .then(|| call_id.clone())
+        })
+        .collect();
+
+    // Keep the entire newest response batch: parallel results must be seen once,
+    // even when that batch alone exceeds the rolling budget.
+    let fresh_start = input
+        .iter()
+        .rposition(|item| {
+            matches!(
+                item,
+                ResponseItem::FunctionCall { .. }
+                    | ResponseItem::CustomToolCall { .. }
+                    | ResponseItem::Reasoning { .. }
+            ) || matches!(item, ResponseItem::Message { role, .. } if role == "assistant")
+        })
+        .map_or(0, |index| index + 1);
+    let mut used = 0_i64;
+    for (index, item) in input.iter_mut().enumerate().rev() {
+        let tokens = estimate_item_token_count(item);
+        let (call_id, output) = match item {
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                output,
+                ..
+            }
+            | ResponseItem::CustomToolCallOutput {
+                call_id, output, ..
+            } if technical_calls.contains(call_id) => (call_id, output),
+            _ => continue,
+        };
+        used = used.saturating_add(tokens);
+        if index < fresh_start && used > recent_evidence_tokens {
+            output.body = FunctionCallOutputBody::Text(
+                crate::boss_text::text(
+                    "evidence.omitted_placeholder",
+                    "[Earlier technical output omitted from active context. Call ID: {call_id}. \
+                     Original output remains in this thread's session log; reopen by call ID \
+                     or rerun the tool call above if needed.]",
+                )
+                .replace("{call_id}", call_id),
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "boss_projection_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/context_manager/boss_projection_tests.rs b/codex-rs/core/src/context_manager/boss_projection_tests.rs
new file mode 100644
index 00000000..8c999331
--- /dev/null
+++ b/codex-rs/core/src/context_manager/boss_projection_tests.rs
@@ -0,0 +1,88 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[test]
+fn boss_projection_ages_evidence_without_changing_conversation_or_fresh_batch() {
+    let call = |id: &str, name: &str| {
+        serde_json::from_value::<ResponseItem>(json!({
+            "type": "function_call", "call_id": id, "name": name, "arguments": "{}"
+        }))
+        .unwrap()
+    };
+    let output = |id: &str, text: &str| {
+        serde_json::from_value::<ResponseItem>(json!({
+            "type": "function_call_output", "call_id": id, "output": text
+        }))
+        .unwrap()
+    };
+    let message = |role: &str| {
+        serde_json::from_value::<ResponseItem>(json!({
+            "type": "message", "role": role,
+            "content": [{"type": "input_text", "text": "Keep this correction and judgment."}]
+        }))
+        .unwrap()
+    };
+    let original = vec![
+        message("user"),
+        call("old", "exec_command"),
+        output("old", &"x".repeat(20_000)),
+        message("assistant"),
+        call("handoff", "wait_agent"),
+        output("handoff", "Worker conclusion"),
+        call("unknown", "unknown_tool"),
+        output("unknown", "Unclassified evidence"),
+        call("recent", "exec_command"),
+        output("recent", "Recent evidence"),
+        message("assistant"),
+        call("new-a", "exec_command"),
+        call("new-b", "exec_command"),
+        output("new-a", "First parallel result"),
+        output("new-b", "Second parallel result"),
+    ];
+    let mut projected = original.clone();
+    project(
+        &mut projected,
+        crate::config::DEFAULT_BOSS_RECENT_EVIDENCE_TOKENS,
+    );
+    let ResponseItem::FunctionCallOutput {
+        call_id,
+        output: payload,
+        ..
+    } = &projected[2]
+    else {
+        panic!()
+    };
+    assert_eq!(call_id.as_deref(), Some("old"));
+    assert!(payload.text_content().unwrap().contains("Call ID: old"));
+    assert!(payload.text_content().unwrap().contains("session log"));
+    let mut expected = original.clone();
+    expected[2] = projected[2].clone();
+    assert_eq!(projected, expected);
+    assert_eq!(original[2], output("old", &"x".repeat(20_000)));
+
+    // A large fresh batch must still be observed in full before it can age out.
+    let mut large_batch = vec![
+        call("a", "exec_command"),
+        call("b", "exec_command"),
+        output("a", &"a".repeat(20_000)),
+        output("b", &"b".repeat(20_000)),
+        message("developer"), // Runtime context injection does not mark results as observed.
+    ];
+    let expected = large_batch.clone();
+    project(
+        &mut large_batch,
+        crate::config::DEFAULT_BOSS_RECENT_EVIDENCE_TOKENS,
+    );
+    assert_eq!(large_batch, expected);
+
