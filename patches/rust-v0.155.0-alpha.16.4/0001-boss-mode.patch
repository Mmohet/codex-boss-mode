 struct SamplingRequestResult {
     needs_follow_up: bool,
     last_agent_message: Option<String>,
+    /// The step's only tool calls handed work to colleagues, and all succeeded.
+    only_handed_work_out: bool,
+}
+
+/// What one sampling step asked tools to do, as far as Boss main parking cares.
+///
+/// A step that only handed work to colleagues has nothing to learn from its
+/// own tool outputs: they acknowledge the hand-off. Sampling again right away
+/// only buys a full-context read that decides to wait. Any other tool call, or
+/// a hand-off that failed, is something the model has to see.
+#[derive(Debug, Default)]
+struct HandOffStep {
+    handed_out: bool,
+    needs_model: bool,
+}
+
+impl HandOffStep {
+    fn observe_call(&mut self, item: &ResponseItem) {
+        match item {
+            ResponseItem::FunctionCall { name, .. } if is_colleague_hand_off_tool(name) => {
+                self.handed_out = true;
+            }
+            ResponseItem::FunctionCall { .. }
+            | ResponseItem::CustomToolCall { .. }
+            | ResponseItem::LocalShellCall { .. }
+            | ResponseItem::ToolSearchCall { .. }
+            | ResponseItem::WebSearchCall { .. }
+            | ResponseItem::ImageGenerationCall { .. } => self.needs_model = true,
+            _ => {}
+        }
+    }
+
+    fn observe_output(&mut self, item: &ResponseItem) {
+        if let ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } = item
+            && output.success == Some(false)
+        {
+            self.needs_model = true;
+        }
+    }
+
+    fn only_handed_work_out(&self) -> bool {
+        self.handed_out && !self.needs_model
+    }
+}
+
+fn is_colleague_hand_off_tool(name: &str) -> bool {
+    matches!(name, "spawn_agent" | "followup_task" | "send_message")
+}
+
+/// Keeps Boss main off the model until something needs it while colleagues work.
+///
+/// Called after a step that only handed work out. Returns when the user steers,
+/// when a colleague asks for main's judgment or hands its work back, when a
+/// plain update has waited `boss_lead_update_hold`, or when nobody is working.
+/// Rechecks now and then in case a colleague stops without a message.
+pub(crate) async fn park_boss_main_while_colleagues_work(
+    sess: &Session,
+    turn_context: &TurnContext,
+    cancellation_token: &CancellationToken,
+) {
+    const RECHECK: Duration = Duration::from_secs(30);
+    let hold = turn_context.config.boss_lead_update_hold;
+    let turn_state = sess
+        .input_queue
+        .turn_state_for_sub_id(&sess.active_turn, &turn_context.sub_id)
+        .await;
+    let (mut activity_rx, pending_activity) = sess
+        .input_queue
+        .subscribe_activity(turn_state.as_deref())
+        .await;
+    if pending_activity == Some(InputQueueActivity::Steer)
+        || sess.input_queue.mailbox_due_for_lead(hold).await
+    {
+        return;
+    }
+    while sess.services.agent_control.any_colleague_working().await {
+        tokio::select! {
+            _ = cancellation_token.cancelled() => return,
+            changed = tokio::time::timeout(RECHECK, activity_rx.changed()) => match changed {
+                Ok(Ok(())) => {
+                    if *activity_rx.borrow_and_update() == InputQueueActivity::Steer {
+                        return;
+                    }
+                }
+                Ok(Err(_)) => return,
+                Err(_) => {}
+            }
+        }
+        if sess.input_queue.mailbox_due_for_lead(hold).await {
+            return;
+        }
+    }
 }
 
