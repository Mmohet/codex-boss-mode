+#[tokio::test]
+async fn boss_main_decision_layer_hides_local_execution_but_workers_keep_it() {
+    let root = probe(|turn| {
+        set_features(
+            turn,
+            &[
+                Feature::BossMainDecisionLayer,
+                Feature::ShellTool,
+                Feature::UnifiedExec,
+                Feature::CodeMode,
+                Feature::RequestPermissionsTool,
+            ],
+        );
+        update_turn_settings_for_test(turn, |settings| {
+            Arc::make_mut(&mut settings.model_info).shell_type = ConfigShellToolType::UnifiedExec;
+            Arc::make_mut(&mut settings.model_info).apply_patch_tool_type =
+                Some(ApplyPatchToolType::Freeform);
+        });
+    })
+    .await;
+
+    root.assert_registered_lacks(&["exec_command", "write_stdin"]);
+    root.assert_visible_lacks(&["exec_command", "write_stdin"]);
+    root.assert_registered_lacks(&["apply_patch", "request_permissions"]);
+    root.assert_visible_lacks(&["apply_patch", "request_permissions"]);
+    assert!(!root.has_terminal_controls);
+    assert_eq!(root.tool_mode, ToolMode::Direct);
+
+    let worker = probe(|turn| {
+        set_features(
+            turn,
+            &[
+                Feature::BossMainDecisionLayer,
+                Feature::ShellTool,
+                Feature::UnifiedExec,
+                Feature::CodeMode,
+                Feature::RequestPermissionsTool,
+            ],
+        );
+        turn.session_source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id: ThreadId::new(),
+            depth: 1,
+            agent_path: Some(AgentPath::try_from("/root/worker").expect("valid agent path")),
+            agent_nickname: None,
+            agent_role: None,
