--- /dev/null
+++ b/codex-rs/core/src/boss_text.rs
@@ -0,0 +1,32 @@
+//! Model-facing text the Boss runtime writes, with replacements from the
+//! profile's `[boss.text]` table.
+//!
+//! Tool descriptions, message envelopes and gate replies are built in places
+//! that never see a `Config`, so the replacements live in one process-wide map
+//! that loading a profile with a `[boss]` table fills. Every call site passes
+//! its built-in text, which is what a key without a replacement gets.
+
+use std::collections::BTreeMap;
+use std::sync::RwLock;
+
+static REPLACEMENTS: RwLock<BTreeMap<String, String>> = RwLock::new(BTreeMap::new());
+
+/// Replaces every earlier replacement with `replacements`.
+pub(crate) fn install(replacements: BTreeMap<String, String>) {
+    if let Ok(mut current) = REPLACEMENTS.write() {
+        *current = replacements;
+    }
+}
+
+/// The text for `key`: the profile's replacement when it has one, otherwise `built_in`.
+pub(crate) fn text(key: &str, built_in: &str) -> String {
+    REPLACEMENTS
+        .read()
+        .ok()
+        .and_then(|current| current.get(key).cloned())
+        .unwrap_or_else(|| built_in.to_string())
+}
