 impl Session {
+    /// Moves this thread's reasoning effort, for the multi-agent tools.
+    ///
+    /// The live turn, if there is one, takes the new level from its next step.
+    /// With `future_turns` the level later turns start at moves too; without it
+    /// the change ends with the live turn. The provider no longer ties its cache
+    /// to the effort level, so either move keeps everything already cached.
+    pub(crate) async fn retune_effort(
+        self: &Arc<Self>,
+        effort: ReasoningEffort,
+        future_turns: bool,
+    ) -> TurnSettingsUpdateOutcome {
+        if future_turns {
+            super::thread_settings::update(
+                self,
+                "retune_effort".to_string(),
+                ThreadSettingsOverrides {
+                    effort: Some(Some(effort.clone())),
+                    ..Default::default()
+                },
+            )
+            .await;
+        }
+        let live_turn_id = {
+            let active = self.active_turn.lock().await;
+            active
+                .as_ref()
+                .and_then(|active| active.task.as_ref())
+                .map(|task| task.turn_context.sub_id.clone())
+        };
+        let Some(live_turn_id) = live_turn_id else {
+            return TurnSettingsUpdateOutcome::TargetUnavailable;
+        };
+        self.apply_turn_settings(
+            &live_turn_id,
+            TurnSettingsUpdate {
+                effort: Some(Some(effort)),
+                ..Default::default()
+            },
+        )
+        .await
+    }
+
+    /// The level this thread is sampling at now: the live turn's, including a
+    /// retune, or the level the next turn will start at when none is running.
+    pub(crate) async fn live_reasoning_effort(&self) -> Option<ReasoningEffort> {
+        let live = {
+            let active = self.active_turn.lock().await;
+            active
+                .as_ref()
+                .and_then(|active| active.task.as_ref())
+                .map(|task| task.turn_context.current_reasoning_effort())
+        };
+        match live {
+            Some(effort) => effort,
+            None => self.thread_settings_snapshot().await.reasoning_effort,
+        }
+    }
