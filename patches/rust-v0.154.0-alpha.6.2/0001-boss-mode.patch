+#[derive(Clone, Copy, Debug, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum AgentAvailability {
+    PendingInit,
+    Running,
+    Idle,
+    Unloaded,
+    Errored,
+    Interrupted,
+}
+
+impl AgentAvailability {
+    fn from_status(status: &AgentStatus) -> Self {
+        match status {
+            AgentStatus::PendingInit => Self::PendingInit,
+            AgentStatus::Running => Self::Running,
+            AgentStatus::Completed(_) => Self::Idle,
+            AgentStatus::Errored(_) => Self::Errored,
+            AgentStatus::Interrupted => Self::Interrupted,
+            AgentStatus::Shutdown | AgentStatus::NotFound => Self::Unloaded,
+        }
+    }
+
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::PendingInit => "pending_init",
+            Self::Running => "running",
+            Self::Idle => "idle",
+            Self::Unloaded => "unloaded",
+            Self::Errored => "errored",
+            Self::Interrupted => "interrupted",
+        }
+    }
 }
 
