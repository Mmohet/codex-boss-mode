@@ -0,0 +1,58 @@
+use super::ContextualUserFragment;
+use codex_protocol::models::ContentItemKind;
+
+/// The connectors reachable in this session, as a name and the description each
+/// one ships with.
+///
+/// This is a runtime fact, not a rule: it says which sources exist, never which
+/// question belongs to which source. Deciding when to consult connected data is
+/// the base instructions' job. Nothing here is inferred — the text comes from
+/// each connector's own metadata, so a different installation renders whatever
+/// that person has connected, and none renders nothing.
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) struct ConnectorInventory {
+    entries: Vec<(String, Option<String>)>,
+}
+
+impl ConnectorInventory {
+    pub(crate) fn new(entries: Vec<(String, Option<String>)>) -> Self {
+        Self { entries }
+    }
+}
+
+impl ContextualUserFragment for ConnectorInventory {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("apps.connector_inventory".to_string())
+    }
+
+    fn role(&self) -> &'static str {
+        "developer"
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<connector_inventory>", "</connector_inventory>")
+    }
+
+    fn body(&self) -> String {
+        let mut body = String::from(
+            "\nSources you can reach in this session. Each description is the one the \
+             source provides for itself.\n",
+        );
+        for (name, description) in &self.entries {
+            body.push_str("- ");
+            body.push_str(name);
+            if let Some(description) = description
+                && !description.is_empty()
+            {
+                body.push_str(" — ");
+                body.push_str(description);
+            }
+            body.push('\n');
+        }
+        body
+    }
+}
