@@ -102,14 +102,46 @@ impl LoaderOverrides {
     }
 
     pub fn user_config_path(&self, codex_home: &Path) -> std::io::Result<AbsolutePathBuf> {
-        match self.user_config_path.as_ref() {
-            Some(path) => Ok(path.clone()),
-            None => Ok(AbsolutePathBuf::resolve_path_against_base(
-                crate::CONFIG_TOML_FILE,
+        if let Some(path) = self.user_config_path.as_ref() {
+            return Ok(path.clone());
+        }
+        if self.user_config_profile.is_none()
+            && let Some(profile) = profile_from_env()
+        {
+            return Ok(AbsolutePathBuf::resolve_path_against_base(
+                format!("{}{CONFIG_PROFILE_V2_SUFFIX}", profile.as_str()),
                 codex_home,
-            )),
+            ));
         }
+        Ok(AbsolutePathBuf::resolve_path_against_base(
+            crate::CONFIG_TOML_FILE,
+            codex_home,
+        ))
+    }
+
+    /// Profile selected by `--profile`, falling back to the environment.
+    ///
+    /// The Desktop app-server is started by the application rather than by a
+    /// shell command, so there is nowhere to pass `--profile` to it. Reading the
+    /// environment here keeps profile selection in the one blessed mechanism
+    /// instead of reproducing config layering somewhere else.
+    pub fn effective_user_config_profile(&self) -> Option<ProfileV2Name> {
+        self.user_config_profile.clone().or_else(profile_from_env)
+    }
+}
+
+/// Environment variable that selects a profile-v2 config when no CLI flag was given.
+pub const CODEX_CONFIG_PROFILE_ENV: &str = "CODEX_CONFIG_PROFILE";
+
+const CONFIG_PROFILE_V2_SUFFIX: &str = ".config.toml";
+
+fn profile_from_env() -> Option<ProfileV2Name> {
+    let raw = std::env::var(CODEX_CONFIG_PROFILE_ENV).ok()?;
+    let trimmed = raw.trim();
+    if trimmed.is_empty() {
+        return None;
     }
+    trimmed.parse().ok()
 }
 
