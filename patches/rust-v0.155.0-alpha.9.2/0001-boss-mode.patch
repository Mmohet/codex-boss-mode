+    }
+
+    pub(crate) fn record_boss_main_observation_call(&self) {
+        let _ = self.boss_main_observation_calls.compare_exchange(
+            0,
+            1,
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        );
+    }
+
+    pub(crate) fn record_boss_main_observation_continuation(&self) -> bool {
+        self.boss_main_observation_calls
+            .compare_exchange(1, 2, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+    }
+
+    pub(crate) fn note_boss_main_visible_rationale(&self) {
+        if self.boss_main_observation_calls() == 1
+            && !self
+                .boss_main_observation_continuation_used
+                .load(Ordering::Acquire)
+        {
+            self.boss_main_observation_rationale
+                .store(true, Ordering::Release);
+        }
+    }
+
+    pub(crate) fn take_boss_main_observation_rationale(&self) -> bool {
+        if self
+            .boss_main_observation_continuation_used
+            .load(Ordering::Acquire)
