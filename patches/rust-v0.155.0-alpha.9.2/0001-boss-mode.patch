+pub(crate) fn strip_boss_stock_instructions(
+    base_instructions: &mut String,
+    stock_instructions: Option<&str>,
+) {
+    let Some(stock_instructions) = stock_instructions.filter(|stock| !stock.is_empty()) else {
+        return;
+    };
+    let suffix = format!("\n\n{stock_instructions}");
+    if let Some(stripped) = base_instructions.strip_suffix(&suffix) {
+        base_instructions.truncate(stripped.len());
+    }
+}
+
+pub(crate) fn append_boss_stock_instructions(
+    base_instructions: &mut String,
+    stock_instructions: &str,
+) {
+    if stock_instructions.is_empty() {
+        return;
+    }
+    let suffix = format!("\n\n{stock_instructions}");
+    if !base_instructions.ends_with(&suffix) {
+        base_instructions.push_str(&suffix);
+    }
+}
