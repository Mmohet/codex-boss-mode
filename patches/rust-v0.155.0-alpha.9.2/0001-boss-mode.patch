+
+/// Narrow only the root Boss session's local filesystem permissions. The
+/// original profile is carried in the runtime config so a spawned Worker can
+/// regain the user's configured execution permissions without changing normal
+/// Codex sessions or treating this as an operating-system security boundary.
+fn apply_boss_main_decision_layer(
+    config: &mut Config,
+    session_source: &SessionSource,
+) -> CodexResult<()> {
+    if !config.features.enabled(Feature::BossMainDecisionLayer)
+        || session_source.is_non_root_agent()
+    {
+        return Ok(());
+    }
+
+    let original_snapshot = config.permissions.permission_profile_state().snapshot();
+    let original_profile = original_snapshot.permission_profile().clone();
+    let Some(intersected_read_only) = original_profile.intersect_with_read_only() else {
+        // An external sandbox owns filesystem enforcement outside Codex. Keep
+        // its existing policy, while tool planning still removes direct patch
+        // and code-mode execution surfaces for the root Boss.
+        warn!("Boss decision-layer filesystem isolation is unavailable under an external sandbox");
+        return Ok(());
+    };
+    let read_only_profile = PermissionProfile::from_runtime_permissions_with_enforcement(
+        SandboxEnforcement::Managed,
+        &intersected_read_only.file_system_sandbox_policy(),
+        original_profile.network_sandbox_policy(),
+    );
+    config
+        .permissions
+        .set_permission_profile(read_only_profile.clone())
+        .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+    if let Some(network) = config.permissions.network.as_ref() {
+        config.permissions.network = Some(
+            network
+                .recompute_for_permission_profile(&read_only_profile)
+                .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?,
+        );
+    }
+    config.boss_main_worker_permission_profile = Some(original_snapshot);
+    Ok(())
+}
