+use super::PreviousSectionState;
+use super::WorldStateSection;
+use crate::context::ConnectorInventory;
+use crate::context::ContextualUserFragment;
+
+/// Tracks the reachable connectors so the list is re-sent only when it changes.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) struct ConnectorInventoryState {
+    entries: Vec<(String, Option<String>)>,
+}
+
+impl ConnectorInventoryState {
+    pub(crate) fn new(entries: Vec<(String, Option<String>)>) -> Self {
+        Self { entries }
+    }
+}
+
+impl WorldStateSection for ConnectorInventoryState {
+    const ID: &'static str = "connector_inventory";
+    type Snapshot = Vec<(String, Option<String>)>;
+
+    fn snapshot(&self) -> Self::Snapshot {
+        self.entries.clone()
+    }
+
+    fn matches_legacy_fragment(role: &str, text: &str) -> bool {
+        role == "developer" && ConnectorInventory::matches_text(text)
+    }
+
+    fn has_retained_fragment_matcher() -> bool {
+        true
+    }
+
+    fn matches_retained_fragment(role: &str, text: &str) -> bool {
+        Self::matches_legacy_fragment(role, text)
+    }
+
+    fn render_diff(
+        &self,
+        previous: PreviousSectionState<'_, Self::Snapshot>,
+    ) -> Option<Box<dyn ContextualUserFragment>> {
+        if self.entries.is_empty()
+            || matches!(previous, PreviousSectionState::Known(previous) if *previous == self.entries)
+        {
+            return None;
+        }
+
+        Some(Box::new(ConnectorInventory::new(self.entries.clone())))
+    }
+}
