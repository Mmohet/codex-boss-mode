@@ -0,0 +1,89 @@
+use super::PreviousSectionState;
+use super::WorldStateHash;
+use super::WorldStateSection;
+use crate::context::BossMainRole;
+use crate::context::ContextualUserFragment;
+use serde::Deserialize;
+use serde::Serialize;
+
+/// Whether the root thread currently runs as Boss main, and with which role.
+///
+/// The model picker is the switch: a turn on one of `[boss] direct_models`
+/// runs the root as plain Codex, any other model runs it as Boss main. The
+/// role is rendered when Boss main starts, or when its text changes, and a
+/// short note sets it aside when the user switches to plain Codex.
+#[derive(Clone, Debug)]
+pub(crate) struct BossMainRoleState {
+    role: String,
+    active: bool,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+pub(crate) struct BossMainRoleSnapshot {
+    active: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    role: Option<WorldStateHash>,
+}
+
+impl BossMainRoleState {
+    pub(crate) fn new(role: &str, active: bool) -> Self {
+        Self {
+            role: role.to_string(),
+            active,
+        }
+    }
+}
+
+impl WorldStateSection for BossMainRoleState {
+    const ID: &'static str = "boss_main_role";
+    type Snapshot = BossMainRoleSnapshot;
+
+    fn snapshot(&self) -> Self::Snapshot {
+        BossMainRoleSnapshot {
+            active: self.active,
+            role: self
+                .active
+                .then(|| WorldStateHash::from_fragment(&BossMainRole::Taken(self.role.clone()))),
+        }
+    }
+
+    /// Threads started before the role was kept apart carry it inside the host
+    /// developer instructions.
+    fn matches_current_legacy_fragment(&self, role: &str, text: &str) -> bool {
+        role == "developer" && text.contains(self.role.trim())
+    }
+
+    fn has_retained_fragment_matcher() -> bool {
+        true
+    }
+
+    fn matches_retained_fragment(role: &str, text: &str) -> bool {
+        role == "developer" && BossMainRole::matches_text(text)
+    }
+
+    fn render_diff(
+        &self,
+        previous: PreviousSectionState<'_, Self::Snapshot>,
+    ) -> Option<Box<dyn ContextualUserFragment>> {
+        let was_active = match previous {
+            PreviousSectionState::Known(previous) if previous == &self.snapshot() => return None,
+            PreviousSectionState::Known(previous) => previous.active,
+            // A legacy thread already shows this role inside its older instructions.
+            PreviousSectionState::Unknown if self.active => return None,
+            PreviousSectionState::Unknown => true,
+            PreviousSectionState::Absent => false,
+        };
+        if self.active {
+            // Boss main starts, or its role changed since it was last shown.
+            Some(Box::new(BossMainRole::Taken(self.role.clone())))
+        } else if was_active {
+            Some(Box::new(BossMainRole::SetAside))
+        } else {
+            None
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "boss_main_role_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/context/world_state/boss_main_role_tests.rs b/codex-rs/core/src/context/world_state/boss_main_role_tests.rs
new file mode 100644
index 00000000..1fbe9463
--- /dev/null
+++ b/codex-rs/core/src/context/world_state/boss_main_role_tests.rs
@@ -0,0 +1,61 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+const ROLE: &str = "# Boss\n\nHold the goal.";
+
+fn rendered(
+    state: &BossMainRoleState,
+    previous: PreviousSectionState<'_, BossMainRoleSnapshot>,
+) -> Option<String> {
+    state
+        .render_diff(previous)
+        .map(|fragment| fragment.render())
+}
+
+#[test]
+fn the_role_follows_the_mode_the_model_picker_chose() {
+    let boss = BossMainRoleState::new(ROLE, /*active*/ true);
+    let direct = BossMainRoleState::new(ROLE, /*active*/ false);
+    let taken = Some(BossMainRole::Taken(ROLE.to_string()).render());
+    let set_aside = Some(BossMainRole::SetAside.render());
+
+    assert_eq!(
+        vec![
+            rendered(&boss, PreviousSectionState::Absent),
+            rendered(&direct, PreviousSectionState::Absent),
+            rendered(&direct, PreviousSectionState::Known(&boss.snapshot())),
+            rendered(&boss, PreviousSectionState::Known(&direct.snapshot())),
+            rendered(&boss, PreviousSectionState::Known(&boss.snapshot())),
+            rendered(&direct, PreviousSectionState::Known(&direct.snapshot())),
+        ],
+        vec![taken.clone(), None, set_aside, taken, None, None],
+        "starts on Boss, starts direct, Boss to direct, direct to Boss, unchanged twice"
+    );
+}
+
+#[test]
+fn a_changed_role_is_shown_again_while_boss_main_runs() {
+    let before = BossMainRoleState::new(ROLE, /*active*/ true);
+    let after = BossMainRoleState::new("# Boss\n\nHold the goal, and the team.", true);
+
+    assert_eq!(
+        rendered(&after, PreviousSectionState::Known(&before.snapshot())),
+        Some(BossMainRole::Taken("# Boss\n\nHold the goal, and the team.".to_string()).render())
+    );
+}
+
+#[test]
+fn a_legacy_thread_keeps_the_role_it_already_shows_until_the_user_switches_to_direct() {
+    let boss = BossMainRoleState::new(ROLE, /*active*/ true);
+    let direct = BossMainRoleState::new(ROLE, /*active*/ false);
+    let merged = format!("<app-context>host</app-context>\n\n{ROLE}");
+
+    assert_eq!(
+        (
+            boss.matches_current_legacy_fragment("developer", &merged),
+            rendered(&boss, PreviousSectionState::Unknown),
+            rendered(&direct, PreviousSectionState::Unknown),
+        ),
+        (true, None, Some(BossMainRole::SetAside.render()))
+    );
+}
