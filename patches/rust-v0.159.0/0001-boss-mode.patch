+#[tokio::test]
+async fn boss_side_fork_states_its_boundary_after_the_cached_prefix() -> Result<()> {
+    use codex_core::ForkSnapshot;
+    use codex_core::StartThreadOptions;
+    use core_test_support::responses::mount_sse_sequence;
+
+    const SIDE_MARKER: &str = "You are in a side conversation, not the main thread.";
+    const BOUNDARY: &str = "Side conversation. Everything above is the main conversation";
+
+    let server = start_mock_server().await;
+    let requests = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![ev_completed("main")]),
+            sse(vec![ev_completed("side")]),
+            sse(vec![ev_completed("plain")]),
+        ],
+    )
+    .await;
+    let mut test = test_codex()
+        .with_config(|config| {
+            config
+                .features
+                .enable(Feature::BossMainDecisionLayer)
+                .expect("enable boss main");
+            config
+                .features
+                .enable(Feature::MultiAgentV2)
+                .expect("enable multi-agent v2");
+            config.developer_instructions = Some("Main instructions.".to_string());
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_text_turn("main").await?;
+    test.codex.flush_rollout().await?;
+    let parent_rollout = test.codex.rollout_path().expect("parent rollout");
+    let environments = test.codex.environment_selections().await;
+    let fork = |developer_instructions: String| {
+        let mut config = test.config.clone();
+        config.ephemeral = true;
+        config.developer_instructions = Some(developer_instructions);
+        test.thread_manager.fork_legacy_thread(
+            ForkSnapshot::TruncateBeforeNthUserMessage(usize::MAX),
+            StartThreadOptions {
+                environments: Some(environments.clone()),
+                ..StartThreadOptions::new(config)
+            },
+            parent_rollout.clone(),
+        )
+    };
+
+    let side = fork(format!("Main instructions.\n\n{SIDE_MARKER}")).await?;
+    let plain = fork("Main instructions.".to_string()).await?;
+    test.codex = side.thread;
+    test.submit_text_turn("side question").await?;
+    test.codex = plain.thread;
+    test.submit_text_turn("plain fork").await?;
+
+    let requests = requests.requests();
+    let main_input = requests[0].body_json()["input"].as_array().unwrap().clone();
+    let side_input = requests[1].body_json()["input"].as_array().unwrap().clone();
+    let plain_input = requests[2].body_json()["input"].as_array().unwrap().clone();
+
+    // Main's whole request is the side conversation's prefix, then the boundary.
+    assert_eq!(side_input[..main_input.len()], main_input[..]);
+    let boundary = &side_input[main_input.len()];
+    assert_eq!(boundary["role"], "developer");
+    assert!(boundary.to_string().contains(BOUNDARY));
+    assert!(
+        side_input
+            .last()
+            .unwrap()
+            .to_string()
+            .contains("side question"),
+        "the question follows the boundary"
+    );
+    // Main can invite colleagues; the side conversation cannot.
+    assert!(
+        requests[0].body_json()["tools"]
+            .to_string()
+            .contains("spawn_agent")
+    );
+    assert!(
+        !requests[1].body_json()["tools"]
+            .to_string()
+            .contains("spawn_agent")
+    );
+
+    // An ordinary ephemeral fork is not a side conversation.
+    assert!(!Value::Array(plain_input).to_string().contains(BOUNDARY));
+    Ok(())
+}
