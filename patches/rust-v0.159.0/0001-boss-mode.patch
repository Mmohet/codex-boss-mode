+        Some(ReasoningEffort::High)
+    );
+    assert_eq!(
+        session.thread_settings_snapshot().await.reasoning_effort,
+        Some(ReasoningEffort::Low)
+    );
+
+    // The parent's retune: this turn and the level later turns start at.
+    assert_eq!(
+        session
+            .retune_effort(ReasoningEffort::Medium, /*future_turns*/ true)
+            .await,
+        TurnSettingsUpdateOutcome::Applied
+    );
+    assert_eq!(
+        turn.current_reasoning_effort(),
+        Some(ReasoningEffort::Medium)
+    );
+    assert_eq!(
+        session.thread_settings_snapshot().await.reasoning_effort,
+        Some(ReasoningEffort::Medium)
+    );
+
+    let done = {
+        let active = session.active_turn.lock().await;
+        Arc::clone(&active.as_ref().unwrap().task.as_ref().unwrap().done)
+    };
+    let completed = done.notified();
+    finish.notify_one();
+    timeout(Duration::from_secs(/*secs*/ 10), completed)
+        .await
+        .expect("task completed");
+
+    // With no turn running, only the later-turn level can move.
+    assert_eq!(
+        session
+            .retune_effort(ReasoningEffort::High, /*future_turns*/ true)
+            .await,
+        TurnSettingsUpdateOutcome::TargetUnavailable
+    );
+    assert_eq!(
+        session.live_reasoning_effort().await,
+        Some(ReasoningEffort::High)
+    );
+}
