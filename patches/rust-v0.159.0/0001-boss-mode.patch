+#[tokio::test]
+async fn idle_colleagues_past_the_threshold_are_compacted_and_the_rest_left_alone() {
+    let harness = AgentControlHarness::new().await;
+    let mut config = harness.config.clone();
+    let _ = config.features.enable(Feature::MultiAgentV2);
+    let root = harness
+        .manager
+        .start_thread(StartThreadOptions::new(config.clone()))
+        .await
+        .expect("root thread should start");
+    let (heavy_id, heavy) = spawn_v2_worker(&harness, &config, root.thread_id, "heavy").await;
+    let (light_id, light) = spawn_v2_worker(&harness, &config, root.thread_id, "light").await;
+    let (busy_id, busy) = spawn_v2_worker(&harness, &config, root.thread_id, "busy").await;
+
+    for (thread, idle) in [(&heavy, true), (&light, true), (&busy, false)] {
+        let turn = thread.session.new_default_turn().await;
+        if idle {
+            thread
+                .session
+                .send_event(turn.as_ref(), turn_complete(turn.as_ref(), Some("done")))
+                .await;
+        }
+        if !Arc::ptr_eq(thread, &light) {
+            thread.session.set_total_tokens_full(turn.as_ref()).await;
+        }
+    }
+
+    let compacted = harness.control.compact_idle_colleagues_above(40).await;
+
+    assert_eq!(compacted, vec![heavy_id]);
+    let compact_targets = harness
+        .manager
+        .captured_ops()
+        .into_iter()
+        .filter(|(_, op)| matches!(op, Op::Compact))
+        .map(|(thread_id, _)| thread_id)
+        .collect::<Vec<_>>();
+    assert_eq!(compact_targets, vec![heavy_id]);
+    assert!(!compact_targets.contains(&light_id));
+    assert!(!compact_targets.contains(&busy_id));
+}
