+    // A large fresh batch must still be observed in full before it can age out.
+    let mut large_batch = vec![
+        call("a", "exec_command"),
+        call("b", "exec_command"),
+        output("a", &"a".repeat(20_000)),
+        output("b", &"b".repeat(20_000)),
+        message("developer"), // Runtime context injection does not mark results as observed.
+    ];
+    let expected = large_batch.clone();
+    project(
+        &mut large_batch,
+        crate::config::DEFAULT_BOSS_RECENT_EVIDENCE_TOKENS,
+    );
+    assert_eq!(large_batch, expected);
+
+    let worker: Vec<_> = original
+        .iter()
+        .filter(|item| durable_worker_item(item))
+        .cloned()
+        .collect();
+    assert_eq!(
+        worker,
+        vec![message("user"), message("assistant"), message("assistant")]
+    );
+}
