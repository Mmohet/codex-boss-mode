+        .await;
+    let (mut activity_rx, pending_activity) = sess
+        .input_queue
+        .subscribe_activity(turn_state.as_deref())
+        .await;
+    let control = sess
+        .services
+        .local_agent_runtime
+        .control(sess.session_id());
+    let due = || async {
+        let held = control
+            .handbacks_to_hold(&sess.services.errand_batches)
+            .await;
+        sess.input_queue.mailbox_due_for_lead(hold, &held).await
+    };
+    if pending_activity == Some(InputQueueActivity::Steer) || due().await {
+        return;
+    }
+    while control.any_colleague_working().await {
+        tokio::select! {
+            _ = cancellation_token.cancelled() => return,
+            changed = tokio::time::timeout(RECHECK, activity_rx.changed()) => match changed {
+                Ok(Ok(())) => {
+                    if *activity_rx.borrow_and_update() == InputQueueActivity::Steer {
+                        return;
+                    }
+                }
+                Ok(Err(_)) => return,
+                Err(_) => {}
+            }
+        }
+        if due().await {
+            return;
+        }
+    }
