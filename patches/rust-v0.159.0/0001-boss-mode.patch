+pub(crate) fn compose_colleague_join_message(
+    shared_context: String,
+    current_focus: Option<String>,
+) -> Result<String, FunctionCallError> {
+    let shared_context = shared_context.trim();
+    if shared_context.is_empty() {
+        return Err(FunctionCallError::RespondToModel(
+            "shared_context must not be empty".to_string(),
+        ));
+    }
+
+    let current_focus = colleague_focus(current_focus);
+    Ok(crate::boss_text::text(
+        "envelope.joining",
+        "Join the shared situation as a colleague.\n\n\
+         Shared context (current result, situation, constraints, and uncertainties):\n{shared_context}\n\n\
+         Current focus (where attention is useful now and may change):\n{current_focus}\n\n\
+         When this turn ends, remain available to continue the shared situation.",
+    )
+    .replace("{shared_context}", shared_context)
+    .replace("{current_focus}", &current_focus))
+}
+
+/// The focus a colleague is handed, or the built-in one when the lead gave none.
+fn colleague_focus(current_focus: Option<String>) -> String {
+    current_focus
+        .as_deref()
+        .map(str::trim)
+        .filter(|focus| !focus.is_empty())
+        .map(str::to_string)
+        .unwrap_or_else(|| {
+            crate::boss_text::text(
+                "envelope.default_focus",
+                "Contribute wherever your judgment can change the shared outcome.",
+            )
+        })
+}
+
+pub(crate) fn compose_encrypted_colleague_join_context(current_focus: Option<String>) -> String {
+    let current_focus = colleague_focus(current_focus);
+    crate::boss_text::text(
+        "envelope.joining_encrypted",
+        "Join the shared situation as a colleague.\n\n\
+         Current focus (where attention is useful now and may change):\n{current_focus}\n\n\
+         The encrypted content below is the shared situation. When this turn ends, remain \
+         available to continue it.",
+    )
+    .replace("{current_focus}", &current_focus)
+}
+
+/// The first message to an agent in a plain role: what the lead wants done, with none of the
+/// colleague framing.
+pub(crate) fn compose_plain_join_message(
+    shared_context: String,
+    current_focus: Option<String>,
+) -> Result<String, FunctionCallError> {
+    let shared_context = shared_context.trim();
+    if shared_context.is_empty() {
+        return Err(FunctionCallError::RespondToModel(
+            "shared_context must not be empty".to_string(),
+        ));
+    }
+    let task = plain_task(current_focus);
+    Ok(crate::boss_text::text(
+        "envelope.plain_joining",
+        "From the lead:\n{task}\n\nContext:\n{shared_context}",
+    )
+    .replace("{task}", &task)
+    .replace("{shared_context}", shared_context))
+}
+
+pub(crate) fn compose_encrypted_plain_join_context(current_focus: Option<String>) -> String {
+    let task = plain_task(current_focus);
+    crate::boss_text::text(
+        "envelope.plain_joining_encrypted",
+        "From the lead:\n{task}\n\nThe encrypted content below is the context for it.",
+    )
+    .replace("{task}", &task)
+}
+
+/// A plain role's task is its focus; with none, the context itself is the task.
+fn plain_task(current_focus: Option<String>) -> String {
+    current_focus
+        .as_deref()
+        .map(str::trim)
+        .filter(|focus| !focus.is_empty())
+        .map(str::to_string)
+        .unwrap_or_else(|| "See the context.".to_string())
+}
