+
+/// What one sampling step asked tools to do, as far as Boss main parking cares.
+///
+/// A step that only handed work to colleagues has nothing to learn from its
+/// own tool outputs: they acknowledge the hand-off. Sampling again right away
+/// only buys a full-context read that decides to wait. Any other tool call, or
+/// a hand-off that failed, is something the model has to see.
+#[derive(Debug, Default)]
+struct HandOffStep {
+    handed_out: bool,
+    needs_model: bool,
+}
+
+impl HandOffStep {
+    fn observe_call(&mut self, item: &ResponseItem) {
+        match item {
+            ResponseItem::FunctionCall { name, .. } if is_colleague_hand_off_tool(name) => {
+                self.handed_out = true;
+            }
+            ResponseItem::FunctionCall { .. }
+            | ResponseItem::CustomToolCall { .. }
+            | ResponseItem::LocalShellCall { .. }
+            | ResponseItem::ToolSearchCall { .. }
+            | ResponseItem::WebSearchCall { .. }
+            | ResponseItem::ImageGenerationCall { .. } => self.needs_model = true,
+            _ => {}
+        }
+    }
+
+    fn observe_output(&mut self, item: &ResponseItem) {
+        if let ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } = item
+            && output.success == Some(false)
+        {
+            self.needs_model = true;
+        }
+    }
+
+    fn only_handed_work_out(&self) -> bool {
+        self.handed_out && !self.needs_model
+    }
+}
+
+fn is_colleague_hand_off_tool(name: &str) -> bool {
+    matches!(name, "spawn_agent" | "followup_task" | "send_message")
+}
