+#[derive(Default)]
+pub(crate) struct ErrandBatches {
+    step: std::sync::atomic::AtomicU64,
+    members: std::sync::Mutex<std::collections::HashMap<AgentPath, u64>>,
+}
+
+impl ErrandBatches {
+    /// Starts a new step of the lead; errands sent from here on form a new batch.
+    pub(crate) fn next_step(&self) {
+        self.step.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    }
+
+    /// Records that `colleague` was sent an errand in the lead's current step.
+    pub(crate) fn record(&self, colleague: AgentPath) {
+        let step = self.step.load(std::sync::atomic::Ordering::Relaxed);
+        if let Ok(mut members) = self.members.lock() {
+            members.insert(colleague, step);
+        }
+    }
+
+    fn snapshot(&self) -> Vec<(AgentPath, u64)> {
+        self.members
+            .lock()
+            .map(|members| {
+                members
+                    .iter()
+                    .map(|(path, step)| (path.clone(), *step))
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+}
+
+/// Whether a colleague is moving the work: starting up or in a turn, and not sitting in
+/// `wait_agent` waiting on someone else.
+async fn colleague_is_moving(thread: &crate::CodexThread) -> bool {
+    matches!(
+        thread.agent_status().await,
+        AgentStatus::PendingInit | AgentStatus::Running
+    ) && !thread
+        .session
+        .services
+        .waiting_on_colleagues
+        .load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// Active context as a share of the model's window, saturating at 100.
+///
+/// The measure is the same active-context figure auto-compaction watches, so a
+/// high reading here is also a warning that the runtime is about to compact on
+/// its own — after the thread has already paid for several turns at that size.
+pub(crate) async fn context_used_percent(thread: &crate::CodexThread) -> Option<u8> {
+    let window = thread
+        .session
+        .token_usage_info()
+        .await?
+        .model_context_window?;
+    if window <= 0 {
+        return None;
+    }
+    let used = thread.session.get_total_token_usage().await;
+    Some(((used.max(0) * 100) / window).min(100) as u8)
+}
+
+impl LocalAgentControl {
+    /// The attributes the lead's roster shows for a colleague: its nickname and whether it is
+    /// working, idle or no longer loaded, so the lead knows who is free without asking.
+    pub(crate) async fn environment_agent_attributes(&self, agent_path: &AgentPath) -> String {
+        let Some(thread_id) = self.runtime.registry.agent_id_for_path(agent_path) else {
+            return String::new();
+        };
+        let nickname = self
+            .runtime
+            .registry
+            .agent_metadata_for_thread(thread_id)
+            .and_then(|metadata| metadata.agent_nickname)
+            .filter(|nickname| !nickname.is_empty())
+            .map(|nickname| format!(r#" nickname="{nickname}""#))
+            .unwrap_or_default();
+        let status = match self.runtime.upgrade() {
+            Ok(state) => match state.get_thread(thread_id).await {
+                Ok(thread) => Some(thread.agent_status().await),
+                Err(_) => None,
+            },
+            Err(_) => None,
+        };
+        let availability = match status {
+            Some(AgentStatus::PendingInit) => "pending_init",
+            Some(AgentStatus::Running) => "running",
+            Some(AgentStatus::Completed(_)) => "idle",
+            Some(AgentStatus::Errored(_)) => "errored",
+            Some(AgentStatus::Interrupted) => "interrupted",
+            Some(AgentStatus::Shutdown | AgentStatus::NotFound) | None => "unloaded",
+        };
+        format!(r#"{nickname} availability="{availability}""#)
+    }
+
+    /// How full a loaded colleague's context is and the effort it samples at now, so a retune
+    /// is judged against what it is actually running at rather than what it was spawned at.
+    pub(crate) async fn colleague_load(
+        &self,
+        thread_id: ThreadId,
+    ) -> (Option<u8>, Option<ReasoningEffort>) {
+        let Ok(state) = self.runtime.upgrade() else {
+            return (None, None);
+        };
+        let Ok(thread) = state.get_thread(thread_id).await else {
+            return (None, None);
+        };
+        (
+            context_used_percent(&thread).await,
+            thread.session.live_reasoning_effort().await,
+        )
+    }
+
+    /// Reports how full each open colleague's context is, for callers that are
+    /// already talking to the roster and should not have to ask separately.
+    ///
+    /// `compact_agent` only helps if someone notices a colleague getting heavy,
+    /// and a reading nobody looks at is the same as no reading. `wait_agent`
+    /// is where the parent already pauses, so the weight rides along there.
+    pub(crate) async fn colleague_activity(
+        &self,
+        baseline: &crate::tools::ToolCallTallyBaseline,
+    ) -> Vec<ColleagueActivity> {
+        let Ok(state) = self.runtime.upgrade() else {
+            return Vec::new();
+        };
+        let mut loads = Vec::new();
+        for metadata in self.runtime.registry.live_agents() {
+            let Some(thread_id) = metadata.agent_id else {
+                continue;
+            };
+            let Ok(thread) = state.get_thread(thread_id).await else {
+                continue;
+            };
+            let Some(percent) = context_used_percent(&thread).await else {
+                continue;
+            };
+            let name = metadata
+                .agent_path
+                .as_ref()
+                .map(ToString::to_string)
+                .unwrap_or_else(|| thread_id.to_string());
+            let since_last_look = baseline.take_delta(
+                &thread_id.to_string(),
+                thread.session.services.tool_call_tally.snapshot(),
+            );
+            loads.push(ColleagueActivity {
+                colleague: name,
+                context_used_percent: percent,
+                reasoning_effort: thread.session.live_reasoning_effort().await,
+                since_last_look,
+            });
+        }
+        loads.sort_by(|left, right| {
+            right
+                .context_used_percent
+                .cmp(&left.context_used_percent)
+                .then_with(|| left.colleague.cmp(&right.colleague))
+        });
+        loads
+    }
+
+    /// Whether any open colleague is starting up or in the middle of a turn.
+    ///
+    /// Boss main only pays to look when looking can change something, and while a
+    /// colleague is still working the only thing that can is its next message or
+    /// the user. Once nobody is working, waiting longer can bring nothing.
+    pub(crate) async fn any_colleague_working(&self) -> bool {
+        let Ok(state) = self.runtime.upgrade() else {
+            return false;
+        };
+        for metadata in self.runtime.registry.live_agents() {
+            let Some(thread_id) = metadata.agent_id else {
+                continue;
+            };
+            let Ok(thread) = state.get_thread(thread_id).await else {
+                continue;
+            };
+            // A colleague sitting in `wait_agent` is waiting on someone else. If every busy
+            // colleague is waiting, nobody is moving the work, and a lead that keeps waiting
+            // would wait on colleagues that in turn wait on it.
+            if colleague_is_moving(&thread).await {
+                return true;
+            }
+        }
+        false
+    }
+
+    /// Colleagues whose handback should wait because someone sent out in the same step is still
+    /// at work. The lead then reads the answers of a batch together instead of waking for each.
+    pub(crate) async fn handbacks_to_hold(
+        &self,
+        batches: &ErrandBatches,
+    ) -> std::collections::HashSet<AgentPath> {
+        let members = batches.snapshot();
+        let Ok(state) = self.runtime.upgrade() else {
+            return std::collections::HashSet::new();
+        };
+        let mut batches_at_work = std::collections::HashSet::new();
+        for (path, step) in &members {
+            if batches_at_work.contains(step) {
+                continue;
+            }
+            let Some(thread_id) = self.runtime.registry.agent_id_for_path(path) else {
+                continue;
+            };
+            if let Ok(thread) = state.get_thread(thread_id).await
+                && colleague_is_moving(&thread).await
+            {
+                batches_at_work.insert(*step);
+            }
+        }
+        members
+            .into_iter()
+            .filter(|(_, step)| batches_at_work.contains(step))
+            .map(|(path, _)| path)
+            .collect()
+    }
+
+    /// Compacts every idle colleague whose context is at least `threshold_percent`
+    /// full, returning the ones it asked to compact.
+    ///
+    /// Colleagues are kept for the understanding they build, so they are reused
+    /// rather than replaced, and a reused colleague only grows. The lead rarely
+    /// stops to compact one, so this runs when the lead's own turn ends: its
+    /// colleagues have just handed their work back, and the compaction happens
+    /// while the user reads the answer. A colleague still working is left alone,
+    /// since compacting it would replace its turn.
+    pub(crate) async fn compact_idle_colleagues_above(
+        &self,
+        threshold_percent: u8,
+    ) -> Vec<ThreadId> {
+        let Ok(state) = self.runtime.upgrade() else {
+            return Vec::new();
+        };
+        let mut compacted = Vec::new();
+        for metadata in self.runtime.registry.live_agents() {
+            let Some(thread_id) = metadata.agent_id else {
+                continue;
+            };
+            let Ok(thread) = state.get_thread(thread_id).await else {
+                continue;
+            };
+            if !matches!(thread.agent_status().await, AgentStatus::Completed(_)) {
+                continue;
+            }
+            if context_used_percent(&thread)
+                .await
+                .is_none_or(|percent| percent < threshold_percent)
+            {
+                continue;
+            }
+            if self.compact_agent(thread_id).await.is_ok() {
+                compacted.push(thread_id);
+            }
+        }
+        compacted
+    }
+}
