+use super::ContextualUserFragment;
+use codex_protocol::models::ContentItemKind;
+
+const SET_ASIDE: &str = "\nThe user has chosen to work with you directly from here on, so the lead role described earlier is set aside. Do the work yourself with your own tools, as a normal Codex session would. Colleagues from earlier are still there if the user asks for them.\n";
+
+/// Boss main's role, shown while the root thread runs as Boss main, or the
+/// note that sets it aside when the user switches to a model that runs the
+/// root as plain Codex.
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) enum BossMainRole {
+    Taken(String),
+    SetAside,
+}
+
+impl ContextualUserFragment for BossMainRole {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("boss.main_role".to_string())
+    }
+
+    fn role(&self) -> &'static str {
+        "developer"
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<boss_main_role>", "</boss_main_role>")
+    }
+
+    fn body(&self) -> String {
+        match self {
+            Self::Taken(role) => format!("\n{}\n", role.trim()),
+            Self::SetAside => crate::boss_text::text("main_role.set_aside", SET_ASIDE),
+        }
+    }
+}
