# Upstream Codex checkout, fetched by scripts/build.sh. Never vendored.
/upstream/
/upstream.backup-*/

# Cargo build cache and outputs. Pinned here on purpose so a build never starts
# a second cache under the upstream checkout -- but never committed.
/target/

# Local, machine-specific config. Only the .example is published.
/boss.config.toml

